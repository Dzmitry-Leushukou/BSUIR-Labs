#include <iostream>
#include <string>

class x0 {
public:
    x0(const std::string& x1);
    void x2() const;
    void x3(int x4);
    int x5() const;
private:
    std::string x6;
    int x7;
};

x0::x0(const std::string& x1) : x6(x1), x7(0) {
    std::cout << "TestClass object \"" << m_name << "\" created." << std::endl;
}

void x0::x2() const {
    std::cout << "Hello from " << x6 << "! Value = " << x7 << std::endl;
}

void x0::x3(int x4) {
    x7 = x4;
}

int x0::x5() const {
    return x7;
}

int main() {
    x0 x8("MyObject");
    x8.x2();
    x8.x3(42);
    x8.x2();
    return 0;
}