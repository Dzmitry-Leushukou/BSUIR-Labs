#include <iostream>

int x0(int x1, int x2) {
    return x1 + x2;
}

int x3(int x1, int x2) {
    return x1 - x2;
}

int x4(int x1, int x2) {
    return x1 * x2;
}

int x5(int x1, int x2) {
    if (x2 == 0) {
        std::cout << "Error: division by zero!" << std::endl;
        return 0;
    }
    return x1 / x2;
}

int main() {
    int x6, x7, x8;
    std::cout << "Simple Calculator\n";
    std::cout << "1. Add\n2. Subtract\n3. Multiply\n4. Divide\n";
    std::cout << "Enter choice: ";
    std::cin >> x6;

    std::cout << "Enter two numbers: ";
    std::cin >> x7 >> x8;

    int x9 = 0;
    switch (x6) {
        case 1: x9 = x0(x7, x8); break;
        case 2: x9 = x3(x7, x8); break;
        case 3: x9 = x4(x7, x8); break;
        case 4: x9 = x5(x7, x8); break;
        default: std::cout << "Invalid choice\n"; return 1;
    }

    std::cout << "Result: " << x9 << std::endl;
    return 0;
}