<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/black">

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:text="0"
        android:textColor="@android:color/white"
        android:textSize="64sp" />

    <!-- Верхний ряд кнопок управления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClear"
            style="@style/CalculatorButton"
            android:text="AC"
            android:textColor="@color/calculator_green" />

        <Button
            android:id="@+id/btnBackspace"
            style="@style/CalculatorButton"
            android:text="⌫"
            android:textColor="@color/calculator_green" />

        <Button
            android:id="@+id/btnHistory"
            style="@style/CalculatorButton"
            android:text="🕒" />

        <Button
            android:id="@+id/btnTheme"
            style="@style/CalculatorButton"
            android:text="🎨" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalculatorButton"
            android:text="/"
            android:textColor="@color/calculator_green" />
    </LinearLayout>

    <!-- Остальные ряды кнопок -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <Button android:id="@+id/btn7" style="@style/CalculatorButton" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalculatorButton" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalculatorButton" android:text="9" />
        <Button android:id="@+id/btnMultiply" style="@style/CalculatorButton" android:text="*" android:textColor="@color/calculator_green" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <Button android:id="@+id/btn4" style="@style/CalculatorButton" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalculatorButton" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalculatorButton" android:text="6" />
        <Button android:id="@+id/btnMinus" style="@style/CalculatorButton" android:text="-" android:textColor="@color/calculator_green" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <Button android:id="@+id/btn1" style="@style/CalculatorButton" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalculatorButton" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalculatorButton" android:text="3" />
        <Button android:id="@+id/btnPlus" style="@style/CalculatorButton" android:text="+" android:textColor="@color/calculator_green" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <Button android:id="@+id/btn0" style="@style/CalculatorButton" android:layout_weight="2" android:text="0" />
        <Button android:id="@+id/btnDot" style="@style/CalculatorButton" android:text="." />
        <Button android:id="@+id/btnEquals" style="@style/CalculatorButton" android:text="=" />
    </LinearLayout>

</LinearLayout>
