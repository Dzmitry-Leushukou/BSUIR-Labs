<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="0"
        android:textSize="40sp"
        android:gravity="end|center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnClear"
            style="@style/CalculatorButton"
            android:text="C"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnBackspace"
            style="@style/CalculatorButton"
            android:text="⌫"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalculatorButton"
            android:text="/"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:weightSum="4">

        <Button
            android:id="@+id/btn7"
            style="@style/CalculatorButton"
            android:text="7"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn8"
            style="@style/CalculatorButton"
            android:text="8"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn9"
            style="@style/CalculatorButton"
            android:text="9"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalculatorButton"
            android:text="*"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:weightSum="4">

        <Button
            android:id="@+id/btn4"
            style="@style/CalculatorButton"
            android:text="4"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn5"
            style="@style/CalculatorButton"
            android:text="5"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn6"
            style="@style/CalculatorButton"
            android:text="6"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btnMinus"
            style="@style/CalculatorButton"
            android:text="-"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:weightSum="4">

        <Button
            android:id="@+id/btn1"
            style="@style/CalculatorButton"
            android:text="1"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn2"
            style="@style/CalculatorButton"
            android:text="2"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btn3"
            style="@style/CalculatorButton"
            android:text="3"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btnPlus"
            style="@style/CalculatorButton"
            android:text="+"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btn0"
            style="@style/CalculatorButton"
            android:text="0"
            android:layout_weight="2" />
        <Button
            android:id="@+id/btnDot"
            style="@style/CalculatorButton"
            android:text="."
            android:layout_weight="1" />
        <Button
            android:id="@+id/btnEquals"
            style="@style/CalculatorButton"
            android:text="="
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>