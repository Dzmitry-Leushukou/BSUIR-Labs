@model Lab1.Domain.Models.Cart

@{
    ViewData["Title"] = "Ваша корзина";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (Model?.CartItems?.Count > 0)
    {
        <div class="table-responsive">
         <table class="table table-hover">
                <thead class="table-dark">
       <tr>
              <th>Изображение</th>
   <th>Название</th>
             <th>Описание</th>
  <th>Цена</th>
                <th>Количество</th>
   <th>Сумма</th>
           <th></th>
            </tr>
     </thead>
        <tbody>
         @foreach (var item in Model.CartItems.Values)
{
       <tr>
   <td>
        @if (!string.IsNullOrEmpty(item.Car.ImagePath))
          {
          <img src="@item.Car.ImagePath" alt="@item.Car.Name" style="max-width: 100px; max-height: 100px;" class="img-fluid" />
     }
              else
       {
         <img src="/images/noimage.jpg" alt="No image" style="max-width: 100px; max-height: 100px;" class="img-fluid" />
          }
         </td>
     <td>@item.Car.Name</td>
  <td>@item.Car.Description</td>
   <td>$@item.Car.Price.ToString("0.00")</td>
        <td>
  <input type="number" value="@item.Count" class="form-control" style="width: 60px;" readonly />
        </td>
        <td>$@((item.Car.Price * item.Count).ToString("0.00"))</td>
     <td>
           <a href="/cart/remove/@item.Car.Id?returnUrl=@Url.Action("Index", "Cart")" class="btn btn-sm btn-danger">
<i class="bi bi-trash"></i>
 </a>
     </td>
          </tr>
      }
 </tbody>
 </table>
  </div>

        <div class="row mt-4">
<div class="col-md-6">
 <h4>Итого:</h4>
  </div>
   <div class="col-md-6 text-end">
  <h4>Количество: @Model.Count шт.</h4>
   <h4>Сумма: $@Model.TotalPrice.ToString("0.00")</h4>
 </div>
        </div>

  <div class="mt-3">
   <a href="/" class="btn btn-secondary">? Продолжить покупки</a>
  <a href="/cart/clear?returnUrl=@Url.Action("Index", "Cart")" class="btn btn-danger">Очистить корзину</a>
     <button class="btn btn-success">Оформить заказ</button>
        </div>
    }
    else
    {
        <div class="alert alert-info">
     Ваша корзина пуста. <a href="/">Вернуться к каталогу</a>
        </div>
    }
</div>