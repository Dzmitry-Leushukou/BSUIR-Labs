@using Client.Services
@using Shared
@inject NavigationManager Navigation

<div class="game-over-container">
    <div class="game-over-card">
        <h2>🎉 Игра окончена!</h2>
    @if (!string.IsNullOrEmpty(WinnerName))
        {
 <p><strong>@WinnerName</strong> победил!</p>
        }
  else
        {
      <p>Спасибо за игру!</p>
        }
<button class="btn btn-primary btn-lg" @onclick="ReturnToLobby">
      Вернуться в лобби
    </button>
    </div>
</div>

@code {
[Parameter]
    public string WinnerName { get; set; } = "";

 private void ReturnToLobby()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

<style>
    .game-over-container {
    display: flex;
        justify-content: center;
  align-items: center;
    min-height: 400px;
    }

  .game-over-card {
 text-align: center;
      padding: 40px;
        background-color: #f8f9fa;
    border-radius: 10px;
        border: 2px solid #28a745;
    }

 .game-over-card h2 {
       color: #28a745;
   margin-bottom: 20px;
    }
</style>
