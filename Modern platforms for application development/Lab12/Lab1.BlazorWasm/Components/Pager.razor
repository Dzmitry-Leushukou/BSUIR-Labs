@using Microsoft.AspNetCore.Components

@if (DataService?.TotalPages > 1)
{
    <nav aria-label="Навигация по страницам" class="mt-4">
 <ul class="pagination justify-content-center">
     @for (int i = 1; i <= DataService.TotalPages; i++)
    {
    var pageNum = i;
  var isActive = DataService.CurrentPage == pageNum;

      <li class="page-item @(isActive ? "active" : "")">
   <button class="page-link" @onclick="@(async () => await OnPageSelected(pageNum))" disabled="@isActive">
    @pageNum
</button>
   </li>
       }
     </ul>
    </nav>
}

@code {
    [Inject]
    public IDataService DataService { get; set; } = default!;

    [Parameter]
   public string? CategoryName { get; set; }

    private async Task OnPageSelected(int pageNo)
    {
        if (DataService != null && pageNo != DataService.CurrentPage)
        {
            await DataService.GetCarsListAsync(pageNo);
        }
    }
}
