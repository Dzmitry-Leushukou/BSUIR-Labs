@using Microsoft.AspNetCore.Components
@implements IDisposable

<div class="list-group">
    @if (DataService?.Cars != null && DataService.Cars.Count > 0)
    {
        @foreach (var car in DataService.Cars)
        {
          <div class="list-group-item">
              <div class="d-flex justify-content-between align-items-start">
     <div class="flex-grow-1">
   <h6 class="mb-1" style="color: #1f2937; font-weight: 600;">
  @car.Name
      @if (car.Price > 0)
                {
    <span style="color: #10b981; font-size: 0.9rem; margin-left: 0.5rem;">
      ?? $@car.Price.ToString("F2")
        </span>
     }
           </h6>
          @if (car.Category != null)
       {
            <p class="mb-1" style="color: #6b7280; font-size: 0.875rem;">
         ?? @car.Category.Name
   </p>
        }
          @if (!string.IsNullOrEmpty(car.Description))
              {
             <p class="mb-1" style="color: #6b7280; font-size: 0.875rem;">
            @car.Description
     </p>
       }
          </div>
      <button class="btn btn-sm btn-outline-primary ms-3" @onclick="@(() => OnCarSelected(car.Id))" title="Подробнее">
    ?? Подробнее
     </button>
            </div>
        </div>
     }
    }
    else
    {
      <div class="alert alert-info mb-0" role="alert">
       <strong>?? Информация:</strong> Нет доступных автомобилей
        </div>
    }
</div>

@code {
    [Inject]
    public IDataService DataService { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnCarSelectedCallback { get; set; }

   protected override void OnInitialized()
    {
    DataService.DataLoaded += StateHasChanged;
   }

    private async Task OnCarSelected(int carId)
    {
        await OnCarSelectedCallback.InvokeAsync(carId);
 }

    public void Dispose()
{
DataService.DataLoaded -= StateHasChanged;
    }
}
