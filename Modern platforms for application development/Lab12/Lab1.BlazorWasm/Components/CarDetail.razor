@using Microsoft.AspNetCore.Components

<div class="card mt-0">
    @if (SelectedCar is not null)
    {
     <div class="card-body">
     <h4 class="card-title mb-3" style="color: #1f2937; font-weight: 600;">
     @SelectedCar.Name
      </h4>

       @if (!string.IsNullOrEmpty(SelectedCar.ImagePath))
     {
        <img src="@SelectedCar.ImagePath" class="img-fluid mb-3 rounded" alt="@SelectedCar.Name" style="max-height: 300px; object-fit: contain; width: 100%; background-color: #f3f4f6; padding: 10px;" />
         }
           else
            {
         <div class="bg-light d-flex align-items-center justify-content-center mb-3 rounded" style="height: 300px; background-color: #f3f4f6;">
    <span class="text-muted" style="color: #9ca3af; font-size: 1.1rem;">📷 Нет изображения</span>
    </div>
 }

        @if (SelectedCar.Category != null)
         {
          <p style="color: #6b7280; margin-bottom: 0.75rem;">
 <strong>📦 Категория:</strong> @SelectedCar.Category.Name
      </p>
     }

        @if (!string.IsNullOrEmpty(SelectedCar.Description))
        {
     <p style="color: #6b7280; margin-bottom: 0.75rem;">
    <strong>📝 Описание:</strong> @SelectedCar.Description
         </p>
     }

  <h5 class="text-success mb-3" style="color: #10b981; font-weight: 600;">
     💰 Цена: $@SelectedCar.Price.ToString("F2")
        </h5>

     <button class="btn btn-success btn-sm">
        🛒 Добавить в корзину
  </button>
        </div>
    }
  else
    {
      <div class="card-body text-center">
     <p class="text-muted" style="color: #9ca3af;">
    👈 Выберите автомобиль из списка для просмотра подробной информации
    </p>
     </div>
   }
</div>

@code {
    [Parameter]
 public Car? SelectedCar { get; set; }
}
