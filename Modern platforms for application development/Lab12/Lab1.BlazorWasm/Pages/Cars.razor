@page "/cars"
@using System.Net.Http.Json
@inject HttpClient Http
@inject ILogger<Cars> Logger

<PageTitle>Галерея автомобилей</PageTitle>

<div class="container py-4">
    <h1>?? Галерея автомобилей</h1>

  @if (loading)
    {
     <div class="alert alert-info">?? Загрузка автомобилей...</div>
    }
else if (error)
    {
   <div class="alert alert-danger">
      <strong>? Ошибка:</strong> @errorMessage
    </div>
}
 else if (cars == null || cars.Count == 0)
    {
    <div class="alert alert-warning">?? Автомобили не найдены.</div>
    }
    else
 {
        <div class="row">
    @foreach (var car in cars)
          {
  <div class="col-md-4 mb-4">
     <div class="card h-100">
      @if (!string.IsNullOrEmpty(car.ImagePath))
 {
       <img src="@car.ImagePath" class="card-img-top" alt="@car.Name" style="height: 200px; object-fit: cover;" />
         }
        else
 {
     <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
   <span class="text-muted">?? Нет изображения</span>
   </div>
     }
  <div class="card-body">
     <h5 class="card-title">@car.Name</h5>
@if (car.Category != null)
        {
    <p class="card-text"><small class="text-muted">?? Категория: @car.Category.Name</small></p>
    }
         @if (!string.IsNullOrEmpty(car.Description))
   {
   <p class="card-text">@car.Description</p>
        }
 <h6 class="text-primary">?? Цена: $@car.Price.ToString("F2")</h6>
         </div>
       <div class="card-footer bg-white">
 <button class="btn btn-sm btn-success" @onclick="() => AddToCart(car)">
           ?? Добавить в корзину
        </button>
           </div>
              </div>
 </div>
    }
        </div>
    }
</div>

@code {
private List<Car>? cars;
    private bool loading = true;
    private bool error = false;
 private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
   try
     {
            cars = await Http.GetFromJsonAsync<List<Car>>("api/cars") ?? new List<Car>();
        }
     catch (Exception ex)
   {
     error = true;
            errorMessage = ex.Message;
     Logger.LogError(ex, "Ошибка при загрузке автомобилей");
        }
        finally
        {
          loading = false;
  }
    }

 private void AddToCart(Car car)
    {
        // TODO: Реализовать функциональность корзины
      Logger.LogInformation($"Добавлен {car.Name} в корзину");
    }
}
