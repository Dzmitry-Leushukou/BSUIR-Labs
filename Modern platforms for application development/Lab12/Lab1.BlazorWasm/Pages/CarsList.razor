@page "/cars-list"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Список автомобилей</PageTitle>

<div class="container py-4">
    <h2>?? Список автомобилей</h2>

    @if (!string.IsNullOrEmpty(DataService.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
    <strong>? Ошибка:</strong> @DataService.ErrorMessage
      </div>
    }

    @if (DataService.Success && DataService.Cars.Count > 0)
    {
        <div class="list-group">
  @foreach (var car in DataService.Cars)
        {
   <div class="list-group-item">
   <h5 class="mb-1">@car.Name</h5>
  @if (car.Category != null)
   {
 <p class="mb-1"><small class="text-muted">?? Категория: @car.Category.Name</small></p>
     }
 <p class="mb-1">?? Цена: $@car.Price.ToString("F2")</p>
         </div>
  }
   </div>
    }
    else if (DataService.Success && DataService.Cars.Count == 0)
    {
        <div class="alert alert-info" role="alert">
   ?? Нет доступных автомобилей
 </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
      ?? Загрузка данных...
  </div>
    }
</div>

@code {
    [Inject]
    public IDataService DataService { get; set; } = default!;

  protected override async Task OnInitializedAsync()
    {
    await DataService.GetCarsListAsync(1);
    }
}
