@page "/menu"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>?? Меню</PageTitle>

<div class="container-fluid">
   <div class="row mb-4">
     <div class="col-12">
      <h1 style="margin: 0;">?? Полное управление меню</h1>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(DataService.ErrorMessage))
   {
        <div class="alert alert-danger" role="alert">
    <strong>? Ошибка:</strong> @DataService.ErrorMessage
  </div>
    }

   <div class="row mb-4">
   <div class="col-md-6 col-lg-4">
       <div class="card">
  <div class="card-header">
      <strong>?? Фильтр</strong>
    </div>
    <div class="card-body">
<CategorySelector />
          </div>
     </div>
    </div>
  </div>

    <div class="row">
       <div class="col-lg-6 mb-4">
    <div class="card">
 <div class="card-header">
     <strong>?? Список автомобилей</strong>
    </div>
 <div class="card-body">
    <CarsListComponent OnCarSelectedCallback="OnCarSelected" />
       </div>
     <div class="card-footer">
   <Pager />
 </div>
 </div>
     </div>

        <div class="col-lg-6 mb-4">
         <div class="card">
  <div class="card-header">
            <strong>?? Подробная информация</strong>
      </div>
          <div class="card-body">
  <CarDetail SelectedCar="SelectedCar" />
        </div>
        </div>
        </div>
    </div>
</div>

@code {
    [Inject]
   public IDataService DataService { get; set; } = default!;

    private Car? SelectedCar;

 protected override async Task OnInitializedAsync()
    {
await DataService.GetCategoryListAsync();
   await DataService.GetCarsListAsync(1);
    }

    private void OnCarSelected(int id)
  {
        SelectedCar = DataService.Cars
 .FirstOrDefault(d => d.Id == id);
    }
}
