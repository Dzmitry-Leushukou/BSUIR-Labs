<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Lab</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">LabsV03</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link active" href="#">Лб 1</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Каталог</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Администрирование</a></li>
                </ul>
                <div class="d-flex align-items-center text-white">
                    <span class="me-3">00,0 руб <i class="bi bi-cart"></i> (0)</span>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle d-flex align-items-center"
                                type="button" id="dropdownMenuButton"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="me-2">user@gmail.com</span>
                            <img src="~/images/default-profile-picture.png" width="30"
                                 alt="User" class="rounded" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton">
                            <li class="px-3 py-2 d-flex align-items-center">
                                <img src="~/images/default-profile-picture.png" width="50" alt="User" class="rounded me-2" />
                                <div>
                                    <div class="fw-bold">user@gmail.com</div>
                                    <div class="small text-muted">Пользователь</div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li class="px-3">
                                <form id="logoutForm" method="post" asp-action="Logout" class="m-0">
                                    <button id="logout" type="submit" class="btn btn-link p-0">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white mt-auto py-3">
        <div class="container">
            <div class="d-flex justify-content-end align-items-center">
                <a class="text-white me-3" href="https://www.facebook.com" target="_blank" rel="noopener">
                    <i class="bi bi-facebook" style="font-size:1.2rem"></i>
                </a>
                <a class="text-white me-3" href="https://vk.com" target="_blank" rel="noopener">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M15.07 2H8.93C3.33 2 2 3.33 2 8.93V15.07C2 20.67 3.33 22 8.93 22H15.07C20.67 22 22 20.67 22 15.07V8.93C22 3.33 20.67 2 15.07 2M18.15 16.27H16.69C16.14 16.27 15.97 15.82 15 14.83C14.12 14 13.74 13.88 13.53 13.88C13.24 13.88 13.15 13.96 13.15 14.38V15.69C13.15 16.04 13.04 16.26 12.35 16.26C10.97 16.26 9.15 15.32 7.97 13.59C5.97 10.77 5.46 9.23 5.46 8.74C5.46 8.54 5.53 8.34 5.85 8.34H7.32C7.69 8.34 7.83 8.5 7.97 8.9C8.69 10.77 9.89 12.3 10.38 12.3C10.58 12.3 10.65 12.21 10.65 11.82V9.67C10.61 9.08 10.07 9.07 10.07 9.07C9.88 9.07 9.68 9.1 9.45 9.2C10.1 8.5 10.94 7.22 11.24 6.5C11.4 6.11 11.55 6 11.92 6H13.5C13.85 6 13.97 6.15 13.97 6.47V11.05C13.97 11.29 14.07 11.39 14.29 11.39C14.43 11.39 14.57 11.34 14.75 11.19C15.49 10.46 16.28 9.32 16.28 9.32C16.45 9.07 16.64 9 16.93 9H18.4C18.72 9 18.85 9.22 18.75 9.5C18.63 9.75 17.9 10.67 16.9 11.72C16.49 12.11 16.3 12.29 16.3 12.47C16.3 12.59 16.37 12.73 16.55 12.88C17.37 13.6 18.03 14.54 18.45 15.23C18.66 15.61 18.56 16 18.15 16.27Z" />
                    </svg>
                </a>
                <a class="text-white" href="https://twitter.com" target="_blank" rel="noopener">
                    <i class="bi bi-twitter" style="font-size:1.2rem"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
