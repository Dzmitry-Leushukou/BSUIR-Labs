@using BattleshipGame.Shared.Models
@using BattleshipGame.Client.Services
@inject BattleshipGame.Client.Services.GameStateService GameState
@inject GameHubService GameHub

<div class="ship-placement-container">
    <h3 class="text-center mb-4">Расстановка кораблей</h3>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
        </div>
    }

    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Разместите ваши корабли на поле (10×10)<br />
        <small>Корабли не должны касаться друг друга даже углами!</small>
    </div>

    <div class="row">
        <!-- Игровое поле -->
        <div class="col-md-8">
            <div class="placement-board">
                <h5>Ваше поле</h5>
                <div class="board-with-coords">
                    <!-- Горизонтальные координаты (буквы) -->
                    <div class="coord-header">
                        @for (int x = 0; x < 10; x++)
                        {
                            <div class="column-letter">@((char)('A' + x))</div>
                        }
                    </div>

                    <!-- Игровое поле с вертикальными координатами -->
                    @for (int y = 0; y < 10; y++)
                    {
                        <div class="coord-row">
                            <!-- Вертикальная координата (цифра) -->
                            <div class="row-number">@(y + 1)</div>

                            <!-- Клетки поля -->
                            @for (int x = 0; x < 10; x++)
                            {
                                var currentX = x;
                                var currentY = y;

                                <div class="board-cell @GetCellClass(x, y)"
                                     @onclick="() => OnCellClick(currentX, currentY)"
                                     title="@GetCellTitle(x, y)">
                                    @if (IsShipCell(x, y))
                                    {
                                        <div class="ship-cell-small"></div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Список кораблей -->
        <div class="col-md-4">
            <div class="ships-panel">
                <h5 class="mb-3">Ваши корабли</h5>
                <div class="mb-3">
                    <button class="btn btn-sm btn-success me-2" @onclick="PlaceRandomly">
                        <i class="fas fa-random"></i> Случайно
                    </button>
                    <button class="btn btn-sm btn-warning me-2" @onclick="ClearAll">
                        <i class="fas fa-trash"></i> Очистить
                    </button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmPlacement"
                            disabled="@(!GameState.AreAllShipsPlaced())">
                        <i class="fas fa-check"></i> Подтвердить
                    </button>
                </div>

                @if (_selectedShipId.HasValue)
                {
                    <div class="selected-ship-info mb-3 p-2 bg-info text-white rounded">
                        <small>Выбран: @GetSelectedShipName() (размер: @GetSelectedShipSize())</small>
                        <button class="btn btn-sm btn-light ms-2" @onclick="RotateSelectedShip"
                                title="Повернуть корабль">
                            <i class="fas fa-redo"></i> Повернуть
                        </button>
                    </div>
                }

                <div class="ships-list">
                    @foreach (var ship in GameState.Ships)
                    {
                        var shipId = ship.Id;
                        <div class="ship-item @(ship.IsPlaced ? "placed" : "not-placed") @(_selectedShipId == ship.Id ? "selected" : "")"
                             @onclick="() => SelectShip(shipId)">
                            <div class="ship-info">
                                <div class="ship-name">@ship.Name</div>
                                <div class="ship-size">Размер: @ship.Size</div>
                                <div class="ship-direction">
                                    @if (ship.IsPlaced)
                                    {
                                        <span>@(ship.IsHorizontal ? "Горизонтально" : "Вертикально")</span>
                                    }
                                    else
                                    {
                                        <span>Не размещен</span>
                                    }
                                </div>
                                <div class="ship-status">
                                    @if (ship.IsPlaced)
                                    {
                                        <span class="badge bg-success">Размещен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Не размещен</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="instructions mt-3">
                    <small>
                        <strong>Инструкция:</strong><br />
                        1. Выберите корабль из списка<br />
                        2. Кликните на поле для размещения<br />
                        3. Нажмите "Повернуть" для смены ориентации<br />
                        4. Нажмите "Случайно" для автоматической расстановки<br />
                        <em>Корабли не должны касаться друг друга!</em>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int? _selectedShipId = null;
    private string _errorMessage = string.Empty;
    private bool _selectedShipHorizontal = true;

    [Parameter]
    public EventCallback OnShipsPlaced { get; set; }

    protected override void OnInitialized()
    {
        // При инициализации выбираем первый неразмещенный корабль
        var firstUnplaced = GameState.Ships.FirstOrDefault(s => !s.IsPlaced);
        if (firstUnplaced != null)
        {
            _selectedShipId = firstUnplaced.Id;
        }
    }

    private string GetCellClass(int x, int y)
    {
        var cell = GameState.GetOwnCell(x, y);
        if (cell == null) return "empty";

        if (cell.HasShip)
        {
            return "ship";
        }

        return "empty";
    }

    private bool IsShipCell(int x, int y)
    {
        return GameState.GetOwnCell(x, y)?.HasShip ?? false;
    }

    private string GetCellTitle(int x, int y)
    {
        var col = (char)('A' + x);
        var row = y + 1;
        return $"{col}{row}";
    }

    private string GetSelectedShipName()
    {
        if (!_selectedShipId.HasValue) return string.Empty;
        var ship = GameState.Ships.FirstOrDefault(s => s.Id == _selectedShipId.Value);
        return ship?.Name ?? string.Empty;
    }

    private int GetSelectedShipSize()
    {
        if (!_selectedShipId.HasValue) return 0;
        var ship = GameState.Ships.FirstOrDefault(s => s.Id == _selectedShipId.Value);
        return ship?.Size ?? 0;
    }

    private void SelectShip(int shipId)
    {
        var ship = GameState.Ships.FirstOrDefault(s => s.Id == shipId);
        if (ship != null)
        {
            _selectedShipId = shipId;
            if (ship.IsPlaced)
            {
                _selectedShipHorizontal = ship.IsHorizontal;
            }
            _errorMessage = string.Empty;
        }
        else
        {
            _selectedShipId = null;
        }
    }

    private void RotateSelectedShip()
    {
        if (_selectedShipId.HasValue)
        {
            var ship = GameState.Ships.FirstOrDefault(s => s.Id == _selectedShipId.Value);
            if (ship != null)
            {
                if (ship.IsPlaced)
                {
                    // Если корабль уже размещен - пытаемся его повернуть
                    var success = GameState.RotateShip(ship.Id);
                    if (!success)
                    {
                        _errorMessage = "Невозможно повернуть корабль! Корабль выходит за границы или касается другого корабля.";
                    }
                }
                else
                {
                    // Если корабль не размещен - просто меняем ориентацию
                    _selectedShipHorizontal = !_selectedShipHorizontal;
                }
            }
        }
    }

    private void OnCellClick(int x, int y)
    {
        if (_selectedShipId.HasValue)
        {
            var ship = GameState.Ships.FirstOrDefault(s => s.Id == _selectedShipId.Value);
            if (ship != null)
            {
                var success = GameState.PlaceShip(ship.Id, x, y, _selectedShipHorizontal);
                if (success)
                {
                    // Автоматически выбираем следующий неразмещенный корабль
                    var nextShip = GameState.Ships.FirstOrDefault(s => !s.IsPlaced);
                    _selectedShipId = nextShip?.Id;
                    if (nextShip != null)
                    {
                        _selectedShipHorizontal = true; // Сбрасываем ориентацию для нового корабля
                    }
                    _errorMessage = string.Empty;
                }
                else
                {
                    _errorMessage = "Невозможно разместить корабль здесь! Проверьте границы и касания с другими кораблями.";
                }
            }
        }
    }

    private void PlaceRandomly()
    {
        GameState.PlaceShipsRandomly();
        _selectedShipId = null;
        _errorMessage = string.Empty;
    }

    private void ClearAll()
    {
        GameState.ClearShips();
        // Выбираем первый корабль после очистки
        var firstShip = GameState.Ships.FirstOrDefault();
        if (firstShip != null)
        {
            _selectedShipId = firstShip.Id;
        }
        _errorMessage = string.Empty;
    }

    private async Task ConfirmPlacement()
    {
        if (GameState.AreAllShipsPlaced())
        {
            try
            {
                // Отправляем корабли на сервер
                var success = await GameHub.PlaceShipsAsync(GameState.Ships);
                if (success)
                {
                    await OnShipsPlaced.InvokeAsync();
                }
                else
                {
                    _errorMessage = "Ошибка при отправке расстановки на сервер";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Ошибка: {ex.Message}";
            }
        }
        else
        {
            _errorMessage = "Не все корабли размещены!";
        }
    }
}