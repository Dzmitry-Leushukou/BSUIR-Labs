@using BattleshipGame.Shared.Models
@using BattleshipGame.Client.Services
@inject BattleshipGame.Client.Services.GameStateService GameState

<div class="ship-placement-container">
    <h3 class="text-center mb-4">Расстановка кораблей</h3>

    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Разместите ваши корабли на поле (10×10)
    </div>

    <div class="row">
        <!-- Игровое поле -->
        <div class="col-md-8">
            <div class="placement-board">
                <h5>Ваше поле</h5>
                <div class="board-with-coords">
                    <!-- Горизонтальные координаты (буквы) -->
                    <div class="coord-header">
                        @for (int x = 0; x < 10; x++)
                        {
                            <div class="column-letter">@((char)('A' + x))</div>
                        }
                    </div>

                    <!-- Игровое поле с вертикальными координатами -->
                    @for (int y = 0; y < 10; y++)
                    {
                        <div class="coord-row">
                            <!-- Вертикальная координата (цифра) -->
                            <div class="row-number">@(y + 1)</div>

                            <!-- Клетки поля -->
                            @for (int x = 0; x < 10; x++)
                            {
                                var currentX = x;
                                var currentY = y;

                                <div class="board-cell @GetCellClass(x, y)"
                                     @onclick="() => OnCellClick(currentX, currentY)"
                                     title="@GetCellTitle(x, y)">
                                    @if (IsShipCell(x, y))
                                    {
                                        <div class="ship-cell-small"></div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Список кораблей -->
        <div class="col-md-4">
            <div class="ships-panel">
                <h5 class="mb-3">Ваши корабли</h5>
                <div class="mb-3">
                    <button class="btn btn-sm btn-success me-2" @onclick="PlaceRandomly">
                        <i class="fas fa-random"></i> Случайно
                    </button>
                    <button class="btn btn-sm btn-warning me-2" @onclick="ClearAll">
                        <i class="fas fa-trash"></i> Очистить
                    </button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmPlacement"
                            disabled="@(!GameState.AreAllShipsPlaced())">
                        <i class="fas fa-check"></i> Подтвердить
                    </button>
                </div>

                <div class="ships-list">
                    @foreach (var ship in GameState.Ships)
                    {
                        var shipId = ship.Id;
                        <div class="ship-item @(ship.IsPlaced ? "placed" : "not-placed") @(_selectedShipId == ship.Id ? "selected" : "")"
                             @onclick="() => SelectShip(shipId)">
                            <div class="ship-info">
                                <div class="ship-name">@ship.Name</div>
                                <div class="ship-size">Размер: @ship.Size</div>
                                <div class="ship-status">
                                    @if (ship.IsPlaced)
                                    {
                                        <span class="badge bg-success">Размещен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Не размещен</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="instructions mt-3">
                    <small>
                        <strong>Инструкция:</strong><br />
                        1. Выберите корабль из списка<br />
                        2. Кликните на поле для размещения<br />
                        3. Нажмите "Случайно" для автоматической расстановки
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int? _selectedShipId = null;

    [Parameter]
    public EventCallback OnShipsPlaced { get; set; }

    private string GetCellClass(int x, int y)
    {
        var cell = GameState.GetOwnCell(x, y);
        if (cell == null) return "empty";

        if (cell.HasShip)
        {
            return cell.IsHit ? "ship-hit" : "ship";
        }

        return "empty";
    }

    private bool IsShipCell(int x, int y)
    {
        return GameState.GetOwnCell(x, y)?.HasShip ?? false;
    }

    private string GetCellTitle(int x, int y)
    {
        var col = (char)('A' + x);
        var row = y + 1;
        return $"{col}{row}";
    }

    private void SelectShip(int shipId)
    {
        var ship = GameState.Ships.FirstOrDefault(s => s.Id == shipId);
        if (ship != null && !ship.IsPlaced)
        {
            _selectedShipId = shipId;
        }
    }

    private void OnCellClick(int x, int y)
    {
        if (_selectedShipId.HasValue)
        {
            var ship = GameState.Ships.FirstOrDefault(s => s.Id == _selectedShipId.Value);
            if (ship != null && !ship.IsPlaced)
            {
                // Пытаемся разместить корабль горизонтально
                var success = GameState.PlaceShip(ship.Id, x, y, true);
                if (!success)
                {
                    // Если не получилось, пробуем вертикально
                    success = GameState.PlaceShip(ship.Id, x, y, false);
                }

                if (success)
                {
                    // Автоматически выбираем следующий неразмещенный корабль
                    _selectedShipId = GameState.Ships
                        .Where(s => !s.IsPlaced)
                        .Select(s => s.Id)
                        .FirstOrDefault();
                }
            }
        }
    }

    private void PlaceRandomly()
    {
        GameState.PlaceShipsRandomly();
        _selectedShipId = null;
    }

    private void ClearAll()
    {
        GameState.ClearShips();
        _selectedShipId = null;
    }

    private async Task ConfirmPlacement()
    {
        if (GameState.AreAllShipsPlaced())
        {
            await OnShipsPlaced.InvokeAsync();
        }
    }
}