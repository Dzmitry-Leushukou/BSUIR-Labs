@using BattleshipGame.Shared.Models

<div class="board-section">
    <h5>@Title</h5>

    <div class="board-with-coords">
        <!-- Горизонтальные координаты (буквы) -->
        <div class="coord-header">
            @for (int x = 0; x < 10; x++)
            {
                <div class="column-letter">@((char)('A' + x))</div>
            }
        </div>

        <!-- Игровое поле с вертикальными координатами -->
        @for (int y = 0; y < 10; y++)
        {
            <div class="coord-row">
                <!-- Вертикальная координата (цифра) -->
                <div class="row-number">@(y + 1)</div>

                <!-- Клетки поля -->
                @for (int x = 0; x < 10; x++)
                {
                    var currentX = x;
                    var currentY = y;

                    <div class="board-cell @GetCellClass(x, y)"
                         @onclick="() => OnCellClick(currentX, currentY)"
                         title="@GetCellTitle(x, y)">
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Игровое поле";

    [Parameter]
    public bool IsOwnBoard { get; set; } = false;

    [Parameter]
    public List<Ship>? Ships { get; set; }

    [Parameter]
    public List<Shot>? Shots { get; set; }

    [Parameter]
    public EventCallback<(int x, int y)> OnCellClicked { get; set; }

    private string GetCellClass(int x, int y)
    {
        var classes = new List<string>();

        // Проверяем выстрелы
        var shot = Shots?.FirstOrDefault(s => s.X == x && s.Y == y);
        if (shot != null)
        {
            if (shot.IsHit)
                classes.Add("hit");
            else
                classes.Add("miss");
        }
        else
        {
            classes.Add("empty");
        }

        // Для своего поля показываем корабли
        if (IsOwnBoard && Ships != null)
        {
            var shipCell = Ships
                .SelectMany(s => s.Cells)
                .FirstOrDefault(c => c.X == x && c.Y == y);

            if (shipCell != null)
            {
                if (shipCell.IsHit)
                    classes.Add("ship-hit");
                else
                    classes.Add("ship");
            }
        }

        return string.Join(" ", classes);
    }

    private string GetCellTitle(int x, int y)
    {
        var col = (char)('A' + x);
        var row = y + 1;
        return $"{col}{row}";
    }

    private async Task OnCellClick(int x, int y)
    {
        // Не позволяем кликать на свое поле (только на поле противника)
        if (!IsOwnBoard)
        {
            await OnCellClicked.InvokeAsync((x, y));
        }
    }
}