@page "/"
@using Client.Services
@using Shared
@inject GameHubService HubService
@inject GameClientLogic GameLogic
@inject NavigationManager Navigation

<PageTitle>Морской бой</PageTitle>

<div class="container mt-4">
    <h1>🎯 Морской бой</h1>

    @if (!isConnected)
    {
        <div class="alert alert-warning">
            <p>Подключение к серверу...</p>
        </div>
    }
    else if (currentGameState == GameState.WaitingForPlayers || string.IsNullOrEmpty(gameId))
    {
        <GameLobby OnGameCreated="HandleGameCreated" OnGameJoined="HandleGameJoined" />
    }
    else if (currentGameState == GameState.PlacingShips)
    {
        <!-- Убраны параметры, так как новый компонент не принимает их -->
        <ShipPlacement />
    }
    else if (currentGameState == GameState.InProgress)
    {
        <GamePlay GameId="@gameId" GameLogic="@GameLogic" />
    }
    else if (currentGameState == GameState.Finished)
    {
        <GameOver WinnerName="@winnerName" />
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }
</div>

@code {
    private bool isConnected = false;
    private GameState currentGameState = GameState.WaitingForPlayers;
    private string? gameId;
    private string? errorMessage;
    private string? winnerName;
    private string? currentPlayerId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Подписываемся на события
            HubService.OnGameStateChanged += HandleGameStateChanged;
            HubService.OnGameStarted += HandleGameStarted;
            HubService.OnErrorReceived += HandleError;
            HubService.OnGameEnded += HandleGameEnded;

            // Подключаемся к хабу
            var baseUri = new Uri(Navigation.BaseUri);
            try
            {
                await HubService.ConnectAsync(baseUri);
                isConnected = HubService.IsConnected;
                currentPlayerId = HubService.CurrentPlayerId ?? "";
            }
            catch (Exception connectEx)
            {
                errorMessage = $"Не удалось подключиться к серверу: {connectEx.Message}";
                Console.WriteLine($"[Ошибка] Подключение не удалось: {connectEx}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка инициализации: {ex.Message}";
            Console.WriteLine($"[Ошибка] OnInitialized не удался: {ex}");
            StateHasChanged();
        }
    }

    private async Task HandleGameCreated((string gameName, string playerName) args)
    {
        try
        {
            await HubService.CreateGameAsync(args.gameName);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleGameJoined((string gameName, string playerName) args)
    {
        try
        {
            await HubService.JoinGameAsync(args.gameName, args.playerName);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleGameStarted(GameStateDto gameState)
    {
        try
        {
            gameId = gameState?.GameId ?? "";
            currentGameState = gameState?.State ?? GameState.WaitingForPlayers;
            GameLogic.InitializeGame(gameId, currentPlayerId ?? "");
            if (gameState != null)
                GameLogic.UpdateGameState(gameState);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Ошибка] HandleGameStarted не удался: {ex}");
            errorMessage = $"Ошибка начала игры: {ex.Message}";
        }
    }

    private async Task HandleGameStateChanged(GameStateDto gameState)
    {
        try
        {
            gameId = gameState?.GameId ?? gameId ?? "";
            currentGameState = gameState?.State ?? currentGameState;
            if (gameState != null)
                GameLogic.UpdateGameState(gameState);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Ошибка] HandleGameStateChanged не удался: {ex}");
            errorMessage = $"Ошибка изменения состояния игры: {ex.Message}";
        }
    }

    private async Task HandleGameEnded(string winnerId, Player winner)
    {
        try
        {
            currentGameState = GameState.Finished;
            winnerName = winner?.Name ?? "Неизвестный";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Ошибка] HandleGameEnded не удался: {ex}");
            errorMessage = $"Ошибка завершения игры: {ex.Message}";
        }
    }

    private async Task HandleError(string message)
    {
        try
        {
            errorMessage = message ?? "Неизвестная ошибка";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Ошибка] HandleError не удался: {ex}");
        }
    }
}

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    h1 {
        color: #333;
        text-align: center;
        margin-bottom: 30px;
    }
</style>