@model Lab1.Domain.Models.ListModel<Lab1.Domain.Entities.Car>

@{
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString.ToUriComponent();

  string? category = request.Query["category"].ToString();
    int currentPage = ViewBag.CurrentPage ?? 1;
  int totalPages = ViewBag.TotalPages ?? 1;
    var isAuth = User?.Identity?.IsAuthenticated == true;
}

<div class="row mt-3">
    @foreach (var item in Model.Items)
    {
        <div class="col-sm-6 col-md-4 mb-4">
            <div class="card h-100">
  <div class="card-img-container" style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
      <img src="@item.ImagePath"
   class="card-img-top"
         style="width: 100%; height: 100%; object-fit: cover;"
         alt="@item.Name"
         onerror="this.onerror=null; this.src='/images/placeholder.png'; this.alt='Изображение не найдено'" />
 </div>
     <div class="card-body d-flex flex-column">
     <h5 class="card-title fs-5 fw-bold">@item.Name</h5>
    <p class="card-text flex-grow-1">@item.Description</p>
           <p class="card-text fw-bold">Цена: $@item.Price.ToString("F2")</p>
         </div>
  <div class="card-footer text-center">
        @if (isAuth)
          {
       <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" asp-route-returnurl="@returnUrl"
    class="btn btn-primary">
  Добавить в корзину
    <i class="bi bi-cart-plus"></i>
             </a>
         }
                    else
        {
      <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(returnUrl)"
           class="btn btn-secondary"
          title="Требуется вход в систему">
           Вход для покупки
   <i class="bi bi-lock"></i>
     </a>
     }
            </div>
            </div>
        </div>
    }
</div>

<!-- Пейджер ДОЛЖЕН быть внутри того же partial, что и список -->
<Pager current-page="@currentPage"
  total-pages="@totalPages"
       category="@category">
</Pager>
